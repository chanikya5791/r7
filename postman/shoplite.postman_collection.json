{
  "info": {
    "_postman_id": "e6a22d55-e226-5135-b2e3-66a6358184b8",
    "name": "ShopLite API",
    "description": "End-to-end API checks for ShopLite: health, auth, catalog, ordering through Kafka and the jobs worker, cancellation, and error cases. Run in order (folders depend on each other).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
