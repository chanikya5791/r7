{
  "name": "shoplite-api-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Black-box API tests for the running ShopLite stack (Users, Catalog and Orders APIs plus the jobs worker)",
  "scripts": {
    "test": "vitest run",
    "test:users": "vitest run tests/users",
    "test:catalog": "vitest run tests/catalog",
    "test:orders": "vitest run tests/orders",
    "test:flows": "vitest run tests/flows",
    "test:newman": "newman run postman/shoplite.postman_collection.json -e postman/local.postman_environment.json",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "newman": "^6.2.3",
    "typescript": "5.6",
    "vitest": "^2.1.9",
    "zod": "^3.25.76"
  }
}
